# build/run artifacts
out/
out_*/
out_*
result
result-*

# bazel
bazel-*
/.bazel/
.bazel-disk-cache/
.bazel-repo-cache/

# secrets — NEVER commit deploy keys (sbc-deploy generates these locally)
deploy/secrets/
*deploy_key*
secrets/
# ...but the deploy-key GENERATOR source + its test are code, not secrets.
!app/deploy_engine/deploy_keys.py
!tests/deploy_keys_test.py
# real WiFi creds live in deploy/secrets/wifi.yaml (above); guard the top-level
# path too so a plaintext PSK can never be committed there. wifi.yaml.example is
# the checked-in template.
deploy/wifi.yaml

# sbc-deploy build scratch (builder VM logs, gc roots)
.sbc-build/

# python
__pycache__/
*.pyc

# nix/direnv
.direnv/

# mlir compiler build
compiler/build/

# rust runtime
runtime_rs/target/
runtime_rs/*.png

# td-deploy Studio app build outputs (all large / per-OS / generated)
app/dist/
app/build/
app/toolchain/
app/version.json
app/electron/node_modules/
app/electron/dist/
__pycache__/
*.pyc

credentials/

# claude-container session-local settings
.claude/

# macOS cruft
.DS_Store

# scratch assets / experiment inputs (not build inputs)
Banana.png
Banana.tif
*_texture_obj.zip
screenshot.png
mesh/
