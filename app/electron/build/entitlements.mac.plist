<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The app spawns a PyInstaller-frozen sidecar which in turn execs the bundled
       clang/lld/mlir/glslang binaries. Under a hardened runtime these need JIT +
       unsigned-memory + library-validation relaxed, and env vars for tool paths. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <!-- osascript "with administrator privileges" for the SD raw write. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
