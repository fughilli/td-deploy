# Bundled JDK SIGILLs at startup on this aarch64 container without this.
startup --host_jvm_args=-XX:+IgnoreUnrecognizedVMOptions
startup --host_jvm_args=-XX:UseSVE=0

# bzlmod + the isolated crate_universe usages that @sbc_deploy (and our own
# runtime_rs crates) rely on.
common --enable_bzlmod
common --experimental_isolated_extension_usages

# Keep the pipeline's Nix/GL work out of Bazel's sandbox: the compiler's native
# steps shell into the pinned Nix env, and the sbc-deploy image/deploy targets
# invoke the host `nix` CLI — both need the host /nix + network.
build --spawn_strategy=local

# Persist fetches + build outputs across container restarts (speeds re-runs).
build --disk_cache=.bazel-disk-cache
common --repository_cache=.bazel-repo-cache

test --test_output=errors
build --symlink_prefix=bazel-

# --- BuildBuddy remote cache + build event stream (CI only) -------------------
# Enabled with `--config=ci`. The API key is NOT stored here: CI passes it from
# the $BUILDBUDDY_API_KEY env var (the CI environment's BUILDBUDDY_API_KEY):
#   bazel test --config=ci \
#     --remote_header=x-buildbuddy-api-key=$BUILDBUDDY_API_KEY //...
# `common:ci` applies to build + test. remote_local_fallback keeps CI working if
# the cache is briefly unreachable; BES upload is best-effort.
common:ci --bes_results_url=https://app.buildbuddy.io/invocation/
common:ci --bes_backend=grpcs://remote.buildbuddy.io
common:ci --remote_cache=grpcs://remote.buildbuddy.io
common:ci --remote_timeout=10m
common:ci --remote_local_fallback
