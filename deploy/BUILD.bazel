"""//deploy — player images + live-deploy targets (via sbc-deploy).

  bazel run //deploy:toxc_artifact                 # compile the demo IR -> artifact
  bazel run //deploy:tdplayer_pi3.image_sd  -- --device /dev/sdX   # flash a Pi 3 SD
  bazel run //deploy:tdplayer.image_sd      -- --device /dev/sdX   # flash a Pi 5 SD
  bazel run //deploy:tdplayer_amd64.image_installer -- --device /dev/sdX  # x86_64 install USB
  bazel run //deploy:tdplayer_pi3.deploy_live -- tdplayer.local    # push to a running Pi
  bazel run //deploy:tdplayer_amd64.deploy_live -- tdplayer.local  # push to a mini PC
  bazel run //deploy:tdplayer_pi3.ssh       -- tdplayer.local
  bazel run //deploy:tdplayer_pi3.keys      -- init

Each image bundles two Bazel-built inputs (build_data): the portable artifact
(:toxc_artifact) and the dynamic Rust runtime cross-built for the image's arch
(//runtime_rs/cross). The flake (deploy/nix) finishes the native lowering for
that arch + autoPatchelfs the runtime. On macOS, sbc-deploy manages the
aarch64 / x86_64 Linux builder VMs.
"""

load("@sbc_deploy//deploy:defs.bzl", "sbc_application")
load(":artifact.bzl", "toxc_artifact")

package(default_visibility = ["//visibility:public"])

# The x86 image's venv step, unit-tested by //:tdplayer_prepare_test.
exports_files(["nix/tdplayer-prepare.py"])

# The compiled artifact baked into the image. Keep the target named
# `toxc_artifact` (deploy/nix/apps.nix reads that basename).
#
# Default = the asset-free demo graph, compiled hermetically. For a REAL project
# that needs the Mac TD bridge (assets + OSC/MIDI services), compile it once:
#   bazel run //:toxc -- /path/ascii_project.toe --emit-artifact deploy/prebuilt/ascii \
#       --target gles2 [--set-file MOVIE=/host/path]
# then swap this target to bake that prebuilt dir (which carries services.json,
# so the deployed runtime picks up the MIDI In CHOP):
#   toxc_artifact(name = "toxc_artifact", prebuilt = glob(["prebuilt/ascii/**"]))
# target MUST match apps.nix's softwareGL: desktop_gl ↔ softwareGL=true (Mesa
# llvmpipe); gles2 ↔ softwareGL=false (Pi VC4/V3D hardware) — gles2 additionally
# needs shaders_gles/ (build_shaders_gles) baked in + /dev/dri access. We run the
# Pi GPU in HARDWARE: apps.nix softwareGL=false, and this prebuilt carries
# shaders_gles/ (emitted --target gles2). NB llvmpipe is no longer even in the
# image — mesa-lean.nix drops it (VC4/V3D only) — so desktop_gl/softwareGL=true
# would have NO software renderer to fall back to.
toxc_artifact(
    name = "toxc_artifact",
    prebuilt = glob(["prebuilt/ascii/**"]),
    prebuilt_strip = "deploy/prebuilt/ascii/",
)

_BUILD_DATA_AARCH64 = [
    ":toxc_artifact",
    # The runtime cross-built for the Pi (aarch64-linux-gnu) — NOT the host
    # //runtime_rs:toxc_runtime, which on a macOS deploy host is a Mach-O binary
    # the Pi can't exec. Keyed as "toxc_runtime" for apps.nix (see transition.bzl).
    "//runtime_rs/cross:toxc_runtime_linux",
]

# Post-build closure push to the self-hosted Attic nix cache (sbc-deploy #25), the
# same cache led_mapper's rigs use. After a successful image/system build the realised
# closure is pushed, so the next build (and the players' own substituter,
# deploy/nix/attic-substituter.nix) pulls the expensive paths — the cross-built
# runtime, the finished artifact, the x86 installer's squashfs inputs — instead of
# rebuilding. Best-effort: never fails a build (e.g. off the tailnet, in CI).
# attic_cache is "<login-name>:<cache>"; the push is tokenless (the cache node's
# Caddy proxy injects the bearer; the tag:attic tailnet ACL is the boundary).
_ATTIC_CACHE = "attic:splanc"

_ATTIC_ENDPOINT = "http://attic.tail6b8ad3.ts.net:8080"

# Pi 5 (default board). `lean` = super-lean base image: drop the RPi sd-image
# rescue toolkit (vim/testdisk/ddrescue/…), all documentation (nixos-manual/man/
# texinfo), and NixOS's default extra packages (perl/rsync/strace) — none are
# wanted on a headless appliance. Flows to the flake via $SBC_LEAN.
sbc_application(
    name = "tdplayer",
    attic_cache = _ATTIC_CACHE,
    attic_endpoint = _ATTIC_ENDPOINT,
    build_data = _BUILD_DATA_AARCH64,
    flake = "deploy/nix",
    hostname = "tdplayer",
    lean = True,
)

# Pi 3B/3B+ variant of the SAME flake + config (board overridden via $SBC_BOARD).
sbc_application(
    name = "tdplayer_pi3",
    attic_cache = _ATTIC_CACHE,
    attic_endpoint = _ATTIC_ENDPOINT,
    board = "@sbc_deploy//deploy/boards:raspberry-pi-3",
    build_data = _BUILD_DATA_AARCH64,
    flake = "deploy/nix",
    hostname = "tdplayer",
    lean = True,
)

# x86_64 mini PC (Intel/AMD iGPU) — the same flake + config under sbc-deploy's
# amd64 family: `image_installer` builds a bootable install USB carrying the
# whole system (offline install onto the internal disk, UEFI/systemd-boot), and
# `deploy_live` pushes new generations to the installed box. The flake adds the
# x86 modules (KMS on the iGPU, Mesa iris/radeonsi, Python for Python-host
# artifacts) off $SBC_BOARD_FAMILY.
_BUILD_DATA_X86_64 = [
    ":toxc_artifact",
    "//runtime_rs/cross:toxc_runtime_linux_x86_64",
]

sbc_application(
    name = "tdplayer_amd64",
    attic_cache = _ATTIC_CACHE,
    attic_endpoint = _ATTIC_ENDPOINT,
    board = "@sbc_deploy//deploy/boards:amd64-generic",
    build_data = _BUILD_DATA_X86_64,
    flake = "deploy/nix",
    hostname = "tdplayer",
    lean = True,
)
